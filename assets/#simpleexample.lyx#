\begin_layout Standard
A simple Prank
\end_layout

\begin_layout Standard
Suppose we have 3 innovations A,
 B,
 C.
\end_layout

\begin_layout Standard
\begin_inset Formula $PV_{C}=10$
\end_inset

 whereas the others have 
\begin_inset Formula $PV=0$
\end_inset

.
 C cites B and B cites A.
 What's the value of all?
\end_layout

\begin_layout Standard
Assume 
\begin_inset Formula $\sigma=0.5$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{C}=\left(1-\sigma\right)PV
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{B}=\sigma\times V_{c}=\sigma\times\left(1-\sigma\right)\times PV
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
V_{A}=\sigma\times V_{B}=\sigma^{2}\times\left(1-\sigma\right)\times PV
\]

\end_inset


\end_layout

\begin_layout Standard
Thus
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\sum_{j}EV_{j}=\left[\left(\sigma+\sigma^{2}\right)\left(1-\sigma\right)\right]PV
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
=\left[\sigma+\sigma^{2}-\sigma^{2}-\sigma^{3}\right]PV
\]

\end_inset


\begin_inset Formula 
\[
=\left[\sigma-\sigma^{3}\right]PV=\sigma\left[1-\sigma^{2}\right]PV=0.5\left(0.75\right)
\]

\end_inset


\end_layout

